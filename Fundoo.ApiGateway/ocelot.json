{
  "Routes": [
    {
      "SwaggerKey": "user",
      "UpstreamPathTemplate": "/api/auth/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH"
      ],
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "user-service",
          "Port": 80
        }
      ],
      "RateLimitOptions": {
        "ClientIdHeader": "ClientId",
        "EnableRateLimiting": true,
        "Limit": 5,
        "Period": "10s",
        "Wait": "20s"
      }
    },
    {
      "SwaggerKey": "notes",
      "UpstreamPathTemplate": "/api/notes/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH"
      ],
      "DownstreamPathTemplate": "/api/notes/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "notes-service",
          "Port": 80
        }
      ],
      "RateLimitOptions": {
        "ClientIdHeader": "ClientId",
        "EnableRateLimiting": true,
        "Limit": 5,
        "Period": "10s",
        "Wait": "20s"
      }
    }
  ],
  "SwaggerEndPoints": [
    {
      "Key": "user",
      "Config": [
        {
          "Name": "Fundoo User API",
          "Version": "v1",
          "Url": "http://user-service/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "notes",
      "Config": [
        {
          "Name": "Fundoo Notes API",
          "Version": "v1",
          "Url": "http://notes-service/swagger/v1/swagger.json"
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://20.255.50.139:30080"
  }
}